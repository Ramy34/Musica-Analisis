const METRICS_URL = 'https://librato-collector.genius.com/v1/metrics';

function sendToLibrato(body) {
  if (navigator.sendBeacon) {
    navigator.sendBeacon(
      METRICS_URL,
      new Blob([JSON.stringify(body)], {type: 'application/json'})
